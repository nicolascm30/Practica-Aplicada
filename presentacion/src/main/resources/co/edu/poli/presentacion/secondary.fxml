<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="TOP_LEFT" spacing="15"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.poli.presentacion.SecondaryController">

    <padding>
        <Insets top="20" bottom="20" left="20" right="20"/>
    </padding>

    <children>
        <Label fx:id="welcomeLabel" text="¡Bienvenido al sistema!" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #007bff;"/>
        <Label fx:id="detailsLabel" text="Detalles del usuario..." style="-fx-font-size: 16px; -fx-text-fill: #333;"/>
        
        <HBox alignment="CENTER_LEFT" spacing="10" VBox.vgrow="ALWAYS">
            <VBox spacing="10" style="-fx-border-color: #ccc; -fx-padding: 15;">
                <Label text="Funciones Comunes" style="-fx-font-weight: bold;"/>
                
                <Button text="🎵 Ver Catálogo" prefWidth="200" onAction="#onCatalogAction"/>
                
                <Button text="🛒 Comprar MP3/Vinilo" prefWidth="200"/>
                <Button text="💰 Recargar Billetera" prefWidth="200"/>
                <Button text="💸 Ver Transacciones" prefWidth="200"/>
            </VBox>
            
            <VBox fx:id="adminMenu" spacing="10" style="-fx-border-color: #f44336; -fx-padding: 15; -fx-border-width: 2;" visible="false">
                <Label text="Menú de Administración" style="-fx-font-weight: bold; -fx-text-fill: #f44336;"/>
                <Button text="📊 Generar Reportes" prefWidth="200"/>
                <Button text="👤 Gestión de Usuarios" prefWidth="200"/>
                <Button text="🏭 Gestión de Proveedores" prefWidth="200"/>
            </VBox>
        </HBox>

        <Button text="🚪 Cerrar Sesión" onAction="#logoutAction" style="-fx-background-color: #555; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </children>

</VBox>