<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.poli.presentacion.CatalogController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <children>
        <Label text="🎵 Catálogo de Canciones Disponibles" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

        <TableView fx:id="tablaCanciones" prefHeight="300.0" prefWidth="500.0">
            <columns>
                <TableColumn fx:id="colTitulo" text="Título" prefWidth="150.0" />
                <TableColumn fx:id="colArtista" text="Artista" prefWidth="150.0" />
                <TableColumn fx:id="colGenero" text="Género" prefWidth="100.0" />
                <TableColumn fx:id="colPrecio" text="Precio" prefWidth="80.0" />
            </columns>
        </TableView>

        <Button text="Cerrar Catálogo" onAction="#cerrarCatalogo" style="-fx-background-color: #d9534f; -fx-text-fill: white;"/>
    </children>
</VBox>