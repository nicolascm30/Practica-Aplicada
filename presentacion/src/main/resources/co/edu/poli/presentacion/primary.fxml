<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.poli.presentacion.PrimaryController">

    <children>
        <Label fx:id="titleLabel" text="INICIO DE SESIÓN" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        
        <TextField fx:id="cedulaField" promptText="Cédula/Identificación" prefWidth="250"/>
        
        <TextField fx:id="passwordField" promptText="Contraseña" prefWidth="250"/> 

        <Button text="🔑 INICIAR SESIÓN" onAction="#onLoginAction"/>
        
        <Label text="¿No tienes cuenta?" style="-fx-text-fill: gray; -fx-font-size: 11px;"/>
        <Button text="📝 REGISTRARSE" onAction="#onRegisterAction"/> 

        <Label fx:id="messageLabel" text="" style="-fx-text-fill: red;"/>
    </children>

    <padding>
        <Insets top="40" bottom="40" left="40" right="40"/>
    </padding>
</VBox>